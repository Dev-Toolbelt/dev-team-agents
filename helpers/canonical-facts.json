{
  "_doc": "Claims known to be wrong. helpers/canonical-facts.py fails when a line under `paths` matches `pattern` (case-insensitive) and no `allow` regex matches the same line. Matching is per line: a correction on the next line does not excuse a hit, so keep the correcting wording on the same line, or add it to `allow` — the allow list is the escape hatch for legitimate uses (e.g. rel=next for browser prefetch). Allow lists are deliberately broad (a negation anywhere on the line suppresses the hit): this is a tripwire for restated claims, not a parser. Each entry carries the reason and the primary source.",
  "paths": [
    "agents",
    "skills",
    "commands",
    "templates"
  ],
  "facts": [
    {
      "id": "fid-as-current-metric",
      "pattern": "\\b(FID|First Input Delay)\\b",
      "allow": [
        "\\b(replaced|retired|deprecated|no longer|never report)\\b",
        "FID\\s*(→|->)\\s*INP"
      ],
      "why": "INP replaced FID as a Core Web Vital in March 2024 — FID is never a current metric or threshold",
      "source": "https://web.dev/blog/inp-cwv-march-12"
    },
    {
      "id": "faq-howto-rich-result-promise",
      "pattern": "\\b(FAQ(Page)?|HowTo)\\b.{0,60}\\b(rich (result|snippet)s?|SERP feature)\\b|\\b(rich (result|snippet)s?|SERP feature)\\b.{0,60}\\b(FAQ(Page)?|HowTo)\\b",
      "allow": [
        "\\bno (rich|FAQ|HowTo)\\b",
        "\\b(never promise|only for|restricted|retired|deprecated|removed|no longer|limited to)\\b"
      ],
      "why": "HowTo rich results were removed in 2023-09; the FAQ rich result was retired for every site on 2026-05-07",
      "source": "https://developers.google.com/search/updates"
    },
    {
      "id": "faq-rich-result-gov-health-only",
      "pattern": "\\bFAQ(Page)?\\b(?=.{0,160}\\b(rich|snippets?|results?|SERP)\\b).{0,160}\\b(gov(ernment)?|health\\w*|medical)\\b|\\b(gov(ernment)?|health\\w*|medical)\\b.{0,160}\\bFAQ(Page)?\\b(?=.{0,160}\\b(rich|snippets?|results?|SERP)\\b)",
      "allow": [
        "\\b(retired|no longer|2026-05|for (any|every) site)\\b"
      ],
      "why": "FAQ rich results were limited to government and health sites from 2023-08 until Google retired them for every site on 2026-05-07 — the gov/health restriction is no longer current",
      "source": "https://developers.google.com/search/updates"
    },
    {
      "id": "rel-next-prev-pagination",
      "pattern": "rel=[\"']?(next|prev)\\b",
      "allow": [
        "\\b(ignored|ignores|no longer|stopped|not used|deprecated)\\b"
      ],
      "why": "Google stopped using rel=next/prev as an indexing signal in 2019",
      "source": "https://developers.google.com/search/docs/specialty/ecommerce/pagination-and-incremental-page-loading"
    },
    {
      "id": "google-extended-affects-search",
      "pattern": "Google-Extended.{0,80}\\b(Search|AI Overviews?|ranking)\\b",
      "allow": [
        "\\b(no effect|does not|doesn't|not affect|never)\\b",
        "\\b(separate from|only governs|governs .{0,30}only)\\b"
      ],
      "why": "Google-Extended controls Gemini training and grounding only; it does not affect Google Search or AI Overviews",
      "source": "https://developers.google.com/search/docs/crawling-indexing/google-common-crawlers#google-extended"
    },
    {
      "id": "sitemap-priority-changefreq-used",
      "pattern": "(<(priority|changefreq)>|\\b(sitemap|xml)\\b.{0,40}\\b(priority|changefreq)\\b).{0,60}\\b(Google|crawl(ing)? (rate|frequency)|ranking)\\b",
      "allow": [
        "\\b(ignore[sd]?|not used|no effect|harmless)\\b"
      ],
      "why": "Google ignores <priority> and <changefreq> in sitemaps",
      "source": "https://developers.google.com/search/docs/crawling-indexing/sitemaps/build-sitemap#additional-notes-about-xml-sitemaps"
    },
    {
      "id": "sitelinks-search-box-benefit",
      "pattern": "sitelinks? search ?box",
      "allow": [
        "\\b(removed|retired|no (Google )?effect|no longer|deprecated)\\b"
      ],
      "why": "Google removed the sitelinks search box from results in November 2024",
      "source": "https://developers.google.com/search/blog/2024/10/sitelinks-search-box"
    },
    {
      "id": "llms-txt-helps-google",
      "pattern": "llms\\.txt.{0,80}\\b(helps?|improves?|boosts?|rank(s|ing)?|increases?|wins?)\\b.{0,60}\\b(Google|AI Overviews?|AI Mode|Search)\\b",
      "allow": [
        "\\b(no|not|neither|nor|never|none|doesn't|does not|isn't|unnecessary|without)\\b"
      ],
      "why": "Google Search does not use llms.txt; it neither helps nor hurts visibility in Search or its AI features",
      "source": "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide"
    },
    {
      "id": "chunking-for-google-ai",
      "pattern": "\\bchunk(s|ing|ed)?\\b.{0,80}\\b(AI Overviews?|AI Mode|Google)\\b|\\b(AI Overviews?|AI Mode|Google)\\b.{0,80}\\bchunk(s|ing|ed)?\\b",
      "allow": [
        "\\b(no|not|neither|nor|never|none|doesn't|does not|isn't|unnecessary|without)\\b"
      ],
      "why": "Google states content does not need to be chunked for its AI features and there is no ideal page length",
      "source": "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide"
    },
    {
      "id": "ai-specific-structured-data",
      "pattern": "\\b(schema(\\.org)?|structured data|markup|JSON-LD)\\b.{0,40}\\b(for|specific to|targeting)\\s+(AI Overviews?|AI Mode|generative AI|AI search|LLMs?)\\b",
      "allow": [
        "\\b(no|not|neither|nor|never|none|doesn't|does not|isn't|unnecessary|without)\\b"
      ],
      "why": "There is no special schema.org markup for Google's generative AI features, and structured data is not required for them",
      "source": "https://developers.google.com/search/docs/fundamentals/ai-optimization-guide"
    },
    {
      "id": "leaked-chatbot-tokens",
      "pattern": "oaicite:\\d|contentReference\\[|citeturn\\d|【\\d+†|utm_source=(chatgpt(\\.com)?|openai|copilot\\.com)|referrer=grok\\.com",
      "allow": [
        "`[^`]*(oaicite|contentReference|citeturn|【|utm_source=|referrer=grok)[^`]*`"
      ],
      "why": "Citation tokens and tracking parameters a chatbot leaves behind; they mark pasted model output and never belong in shipped text",
      "source": "https://pt.wikipedia.org/wiki/Wikip%C3%A9dia:Sinais_de_texto_gerado_por_intelig%C3%AAncia_artificial"
    },
    {
      "id": "crawl-delay-honoured-by-google",
      "pattern": "crawl[- _]?delay",
      "allow": [
        "\\b(ignored|ignores|not supported|unsupported|does not|doesn't|never)\\b",
        "^(?!.*\\bgoogle).*\\b(Bing|Yandex)\\b"
      ],
      "why": "Googlebot does not support the crawl-delay robots.txt rule; Google adjusts its crawl rate from server responses",
      "source": "https://developers.google.com/search/docs/crawling-indexing/robots/robots_txt#syntax"
    },
    {
      "id": "url-parameters-tool",
      "pattern": "URL Parameters?( handling)? (tool|report)",
      "allow": [
        "\\b(retired|removed|deprecated|no longer|never recommend)\\b"
      ],
      "why": "Search Console's URL Parameters tool was retired in 2022; parameter URLs are handled on the site",
      "source": "https://developers.google.com/search/blog/2022/03/url-parameters-tool-deprecated"
    },
    {
      "id": "410-faster-than-404",
      "pattern": "\\b410\\b.{0,60}\\b(faster|quicker|quickly|sooner|rapidly|promptly)\\b|\\b(faster|quicker|quickly|sooner|rapidly|promptly)\\b.{0,60}\\b410\\b",
      "allow": [
        "\\b(treats? it like|same as|no faster|not faster|identical)\\b"
      ],
      "why": "Google treats all 4xx responses except 429 the same way for indexing; 410 is not documented as faster than 404",
      "source": "https://developers.google.com/search/docs/crawling-indexing/http-network-errors#4xx-client-errors"
    },
    {
      "id": "gitleaks-pre-8-19-subcommands",
      "pattern": "gitleaks\\s+(detect|protect)\\b",
      "allow": [
        "\\b(deprecated|pre-8\\.19|instead of|replaced)\\b"
      ],
      "why": "gitleaks 8.19 replaced `detect`/`protect` with `gitleaks git` / `gitleaks dir` / `gitleaks git --pre-commit --staged`; the old ones are hidden and deprecated",
      "source": "https://github.com/gitleaks/gitleaks#usage"
    },
    {
      "id": "semgrep-returntocorp-action-or-image",
      "pattern": "returntocorp/semgrep",
      "allow": [
        "\\b(deprecated|moved)\\b"
      ],
      "why": "returntocorp/semgrep-action is deprecated and the image is published as semgrep/semgrep",
      "source": "https://semgrep.dev/docs/semgrep-ci/sample-ci-configs"
    },
    {
      "id": "graphify-wrong-package-name",
      "pattern": "(npm|pip|pipx|uv tool)\\s+install\\s+(-g\\s+|--user\\s+)?graphify\\b",
      "allow": [
        "\\bnever install\\b",
        "\\bdifferent project\\b"
      ],
      "why": "the graphify CLI ships as the PyPI distribution `graphifyy`; `graphify` on PyPI and npm is an unrelated project (typosquat risk)",
      "source": "https://pypi.org/project/graphifyy/"
    },
    {
      "id": "backlog-time-estimates",
      "pattern": "\\*\\*(Estimate|Estimated (duration|effort|total))\\*\\*|\\| *Estimated total *\\||\\bestimate\\b.{0,40}[x\u00d7] ?1\\.3\\b",
      "allow": [
        "\\bnever (produce|show|store|write)\\b"
      ],
      "why": "sprint and backlog files carry real Started/Finished/Time spent, never hour estimates, buffers or delivery forecasts; an estimate is given in chat only when the user asks",
      "source": "skills/shared/backlog-template/SKILL.md \u00a7 Estimates"
    }
  ]
}
