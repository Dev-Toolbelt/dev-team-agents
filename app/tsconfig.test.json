{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "test/**/*",
    "src/cli/**/*",
    "src/shared/**/*",
    "src/main/**/*",
    "vite.config.mts",
    "vite.preload.config.mts",
    "vitest.config.mts",
    "scripts/**/*"
  ]
}
