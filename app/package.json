{
  "name": "dev-team-agents-app",
  "productName": "Dev Team Agents",
  "version": "0.1.1",
  "private": true,
  "description": "Desktop client for the dev-team-agents multi-agent development harness (ADR-0011)",
  "license": "MIT",
  "main": "dist/node/main/index.js",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import{rmSync}from'node:fs';rmSync('dist',{recursive:true,force:true});rmSync('release',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:node && npm run build:preload && npm run build:renderer",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "dev:renderer": "vite",
    "dev:app": "node scripts/dev-app.mjs",
    "start": "npm run build && node scripts/brand-dev-electron.mjs && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:all": "npm run build && electron-builder --mac --win --publish never && node scripts/zip-release.mjs && node scripts/checksums.mjs",
    "dist:beta": "node scripts/release-guard.mjs && npm run dist:all",
    "checksums": "node scripts/checksums.mjs",
    "build:preload": "vite build -c vite.preload.config.mts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "author": "dev-team-agents contributors",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents": false
  }
}
