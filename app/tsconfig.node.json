{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist/node",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "src/cli/**/*",
    "src/main/**/*",
    "src/shared/**/*"
  ]
}
