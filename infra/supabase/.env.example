# Placeholders only. Real values live in your shell, the Supabase dashboard and
# `supabase secrets set`, never in git. Copy to .env (gitignored) for local `supabase start`.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
SMTP_HOST=smtp.example.com
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_ADMIN_EMAIL=accounts@example.com
# Edge Function secrets (set with `supabase secrets set`, not used by config.toml)
ENTITLEMENT_ED25519_PRIVATE_KEY=base64-pkcs8-private-key
ENTITLEMENT_KID=2026-10-a
BAN_HMAC_KEY=base64-32-random-bytes
# Optional: the token issuer; leave unset in the cloud (defaults to SUPABASE_URL).
# ENTITLEMENT_ISSUER=http://127.0.0.1:54321
