{
  "$schema": "internal://commands.json",
  "_comment": "Per-command metadata. The command body lives verbatim at commands/<name>.md. The renderer uses this file to (a) choose the lead agent for opencode/codex, (b) resolve the model id via tiers.json, (c) emit the frontmatter expected by each provider, (d) apply plan gate softening per provider. Add a new row when adding a command; do NOT add frontmatter to commands/*.md directly (Claude Code parses them as body-only).",
  "_plan_gate_values": {
    "required": "Always present plan + wait for approval. Used for architectural/planning commands.",
    "conditional": "Use plan mode for complex tasks; execute directly for simple ones. Plan gate text is softened for non-Claude providers.",
    "opt_out": "No plan gate. Used for thin runner commands (update, symlinks)."
  },
  "commands": {
    "plan":              { "tier": "reasoning",    "agent": "product-analyst",     "description": "Plan a feature — product-analyst leads, optional software-architect.",                        "plan_gate": "required" },
    "architect":         { "tier": "reasoning",    "agent": "software-architect",  "description": "Architecture decisions, ADRs, trade-offs.",                                               "plan_gate": "required" },
    "adr":               { "tier": "reasoning",    "agent": "software-architect",  "description": "Create a new Architecture Decision Record.",                                            "plan_gate": "required" },
    "refactor":          { "tier": "reasoning",    "agent": "software-architect",  "description": "Structured refactoring: dependency mapping, ordered commits.",                        "plan_gate": "required" },
    "security":          { "tier": "reasoning",    "agent": "security-specialist",  "description": "Security audit or vulnerability analysis.",                                          "plan_gate": "required" },
    "backend":           { "tier": "backend-exec", "agent": "backend-developer",   "description": "Implement backend changes.",                                                        "plan_gate": "conditional" },
    "frontend":          { "tier": "frontend",     "agent": "frontend-developer",  "description": "Implement frontend changes.",                                                       "plan_gate": "conditional" },
    "fullstack":         { "tier": "backend-exec", "agent": "backend-developer",   "description": "Implement full-stack changes end-to-end.",                                            "plan_gate": "conditional" },
    "mobile":            { "tier": "backend-exec", "agent": "mobile-developer",    "description": "Implement mobile features.",                                                         "plan_gate": "conditional" },
    "fix":               { "tier": "backend-exec", "agent": "backend-developer",   "description": "Fix a bug (auto-routes to backend/frontend/mobile developer).",                      "plan_gate": "conditional" },
    "dba":               { "tier": "backend-exec", "agent": "database-specialist",  "description": "Schema design, query optimization, migrations.",                                    "plan_gate": "conditional" },
    "devops":            { "tier": "backend-exec", "agent": "devops-specialist",   "description": "CI/CD, Docker, infra, deploy scripts.",                                              "plan_gate": "conditional" },
    "review":            { "tier": "backend-exec", "agent": "code-reviewer",       "description": "Code review before merge.",                                                        "plan_gate": "conditional" },
    "qa":                { "tier": "backend-exec", "agent": "qa-specialist",       "description": "Validate feature behavior and acceptance criteria.",                                 "plan_gate": "conditional" },
    "design":            { "tier": "frontend",     "agent": "ui-ux-designer",      "description": "Design system, UX flows, visual decisions.",                                        "plan_gate": "conditional" },
    "tester":            { "tier": "repetitive",  "agent": "backend-test-specialist", "description": "Write or update tests only.",                                                    "plan_gate": "conditional" },
    "docs":              { "tier": "repetitive",  "agent": "technical-writer",    "description": "Docs, changelogs, runbooks, release notes.",                                          "plan_gate": "conditional" },
    "pr":                { "tier": "repetitive",  "agent": "technical-writer",    "description": "Draft and create a pull request.",                                                  "plan_gate": "conditional" },
    "commit":            { "tier": "repetitive",  "agent": "technical-writer",    "description": "Group staged changes by layer and write commits.",                                  "plan_gate": "conditional" },
    "learn":             { "tier": "repetitive",  "agent": "technical-writer",    "description": "Consolidate session decisions into docs, wiki, ADRs.",                              "plan_gate": "conditional" },
    "update":            { "tier": "repetitive",  "agent": "technical-writer",    "description": "Check for and apply dev-team-agents updates.",                                      "plan_gate": "opt_out" },
    "symlinks":          { "tier": "repetitive",  "agent": "technical-writer",    "description": "Diagnose and repair broken dev-team-agents symlinks.",                              "plan_gate": "opt_out" },
    "health-check":      { "tier": "backend-exec", "agent": "setup-assistant",    "description": "Health check — validate and repair dev-team-agents installation.",                  "plan_gate": "opt_out" }
  }
}